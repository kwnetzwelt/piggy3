# Comma-separated types, order preserved. Used for grouping and dropdowns.
ACCOUNT_TYPES=Ausgabe,Sparen,Haus

# Single-user login. Change both before exposing the app.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# At least 32 characters. Change this before exposing the app.
AUTH_JWT_SECRET=please-change-this-secret-32-chars-minimum

# MongoDB database name (the connection string is set in docker-compose.yml).
MONGO_DATABASE_NAME=piggy3

# Host port for the frontend.
FRONTEND_PORT=5000
