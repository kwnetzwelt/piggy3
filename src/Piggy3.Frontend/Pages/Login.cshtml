@page
@model LoginModel
@{
    ViewData["Title"] = "Anmelden";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4 text-center">Piggy</h1>

                @if (Model.Error is not null)
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Benutzername</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Passwort</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Anmelden</button>
                </form>
            </div>
        </div>
    </div>
</div>
